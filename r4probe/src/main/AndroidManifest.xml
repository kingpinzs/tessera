<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility: without this the probe cannot see the shell and reports it as missing. -->
    <queries>
        <package android:name="app.tileshell" />
    </queries>

    <!-- P5 draws a full-height overlay and measures whether it reaches under the nav bar. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- R4 phone-only: the probe pairs with and connects to the phone's own adbd (Wireless debugging) over TCP. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_r4probe"
        android:label="R4 probe"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="R4 probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- R4 part 2: the helper (the shell's app_process) hands its binder in here. Exported because the caller is
             the shell; HelperProvider takes the binder only from uid 2000 (shell) or 0 (root). -->
        <!-- P5: the accessibility overlay phase 04's action center uses; turned on and off by the R4 script only. -->
        <service
            android:name=".ProbeA11yService"
            android:exported="true"
            android:label="R4 probe (nav-bar test)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_probe" />
        </service>

        <!-- R4 phone-only: pairs with the phone's own Wireless debugging in the background (the pairing dialog stays in
             front). The run's notification reply reaches the non-exported one; the emulator test uses the exported one,
             which only a DUMP holder (the shell, the system) may call. -->
        <receiver android:name=".PairReceiver" android:exported="false" />
        <receiver
            android:name=".PairTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <provider
            android:name=".HelperProvider"
            android:authorities="app.tessera.r4probe.helper"
            android:exported="true" />
    </application>
</manifest>
