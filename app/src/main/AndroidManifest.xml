<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A default Home lists and launches every app (sideloaded, no store policy applies). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Back on Start (Usage access), granted by the user through the onboarding checklist. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- The app list's hold menu offers Uninstall (Jeremy, 2026-09-22). Android hands the request to its
         own package installer, which asks the user; without this permission that activity finishes
         silently and the tap appears to do nothing, which is exactly what the first run of the UNINSTALL
         row caught. Normal permission: granted at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Phase 10: the music library. Q6 indexes everything MediaStore calls audio, which is what this
         grants read of; without it the player says so rather than showing an empty library (E18). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Phase 10: playback outlives Start, which is the point of the service (E7). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Phase 10 task 9: the equaliser is an AudioEffect on the player's own session. A normal
         permission, granted at install. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Private space apps are only visible to the default Home with this permission (Android 15+). -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Samsung badge provider read (R5 §2.4); whether One UI grants it is probed at runtime (P6). -->
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" />

    <!-- ===== Phase 03: Cortana ===== -->
    <!-- Voice requests. The models never leave the device and Cortana makes no network request. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- "Call/text <contact>" and person reminders resolve names through the Contacts provider. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- "What's on my calendar" reads; "add a calendar event" inserts after the confirmation card. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- The action layer sends the text itself (SmsManager) and places the call itself (TelecomManager). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Reminders fire at the exact time. A sideloaded app gets this at install; no Play policy applies (F1-m7). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Phase 15, Alarms & Clock (build tasks 1-3): the ring plays on the alarm stream, vibrates and holds a wake lock
      for its ten minutes; its full-screen intent shows the toast over the keyguard (a special app access on API 34+,
      the "Full-screen alarms" Setup row); "Display over other apps" draws the toast over the app in use (Q-E A, the
      "Display over other apps" Setup row); RECEIVE_BOOT_COMPLETED re-arms alarms and timers at LOCKED_BOOT_COMPLETED,
      before the first unlock (T15-22 — the manifest held none, so BOOT_COMPLETED never reached ReminderReceiver);
      the ring service is a systemExempted foreground service, which an app holding USE_EXACT_ALARM may run to ring an
      alarm (the Decisions' build-start check).
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Place reminders: Android's own proximity alerts, no Google Play services (P5). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!--
      Person reminders read the call log and the SMS provider. Both are hard-restricted: an app holding
      no dialer or SMS role gets them only because the installer allow-lists them, which "adb install"
      does unless its restrict-permissions flag is passed. The shell is never installed with that flag, and
      the checklist has a row for each (Decisions "Place and person reminder mechanics" (1)).
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- ===== Phase 15: Voice Recorder ===== -->
    <!-- The take is a foreground service of type microphone in its own :recorder process (build task 7). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:name=".ShellApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.TileShell">

        <activity
            android:name=".StartActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Phase 10: the music player is an APP, not an internal page (Q5) — a launcher activity with
            APP_MUSIC, so it sits in the app list like any app and the MUSIC slot can point at it the way
            it points at any music app. Groove was an app in W10M's list too.
        -->
        <!--
            Phase 10 build tasks 3 and 4. Android draws the notification transport from this session and
            routes headset and Bluetooth buttons to it, so neither is a second thing to build.
        -->
        <service
            android:name=".music.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <activity
            android:name=".music.MusicActivity"
            android:exported="true"
            android:label="Music"
            android:taskAffinity="app.tileshell.music"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
            <!-- Phase 11: Music's pivots as static App Shortcuts (interview Q1 A), on this activity for the per-activity query. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts_music" />
        </activity>

        <!--
            Phase 15 build task 4: Alarms & Clock is an APP in the shell APK exactly as Music is — a launcher
            activity with its own task. singleTask, so a notification, the lock screen's next alarm, a pinned
            timer's tile, an App Shortcut or the AlarmClock handler re-routes the running app (onNewIntent) instead
            of stacking a second one. Its static App Shortcuts are build task 9's.
        -->
        <activity
            android:name=".clock.ClockActivity"
            android:exported="true"
            android:label="@string/clock_name"
            android:icon="@drawable/ic_clock"
            android:taskAffinity="app.tileshell.clock"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts_clock" />
        </activity>

        <!--
            Phase 15 T15-37: the AlarmClock API handler — a translucent trampoline other apps' SET_ALARM / SET_TIMER /
            SHOW_ALARMS / SHOW_TIMERS reach, guarded by com.android.alarm.permission.SET_ALARM as AOSP DeskClock's is.
            It validates every request (AlarmApiRules), creates the item or opens the editor filled in, and never
            edits or deletes an existing alarm (trust item (j)). Listed in qa/phase-03/exported-allowlist.txt.
        -->
        <activity
            android:name=".clock.AlarmApiActivity"
            android:exported="true"
            android:permission="com.android.alarm.permission.SET_ALARM"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="app.tileshell.clock.api">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.SET_TIMER" />
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <action android:name="android.intent.action.SHOW_TIMERS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".weather.WeatherActivity"
            android:exported="true"
            android:label="Weather"
            android:taskAffinity="app.tileshell.weather"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="Start settings"
            android:taskAffinity="app.tileshell.settings"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase 11: Start settings' pages as static App Shortcuts (interview Q1 A), on this activity for the per-activity query. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts_settings" />
        </activity>

        <service
            android:name=".feeds.TileNotificationListener"
            android:exported="true"
            android:label="Live tiles"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Public Live Tile API (R5 §4b). No permissions by design: every call() verb authorises on Binder identity. -->
        <provider
            android:name=".tiles.api.LiveTileProvider"
            android:authorities="app.tileshell.livetile"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Legacy badge broadcasts (R5 §2.5): manifest entry so senders resolve the shell; the runtime copy receives implicit sends. -->
        <receiver
            android:name=".tiles.api.LegacyBadgeReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BADGE_COUNT_UPDATE" />
                <action android:name="me.leolin.shortcutbadger.BADGE_COUNT_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- Live Tile API expiry / scheduled-delivery alarm and uninstall cleanup. Only the system and the shell reach it. -->
        <receiver
            android:name=".tiles.api.LiveTileSystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- ===== Phase 03: Cortana ===== -->

        <!--
          The assistant. Exported and guarded by BIND_VOICE_INTERACTION, which only the system holds:
          that is how a VoiceInteractionService is declared, and it is what the assist gesture, the side
          key and KEYCODE_ASSIST reach.
        -->
        <service
            android:name=".cortana.CortanaService"
            android:exported="true"
            android:label="@string/cortana_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- The session's window: Cortana's pages, its persona and its drawn W10M bars. -->
        <service
            android:name=".cortana.CortanaSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
          A VoiceInteractionService must name a RecognitionService. This one is the offline engine behind
          the same `:speech` process the session uses; phase 05's voice typing binds it as a normal client.
        -->
        <service
            android:name=".cortana.CortanaRecognitionService"
            android:exported="true"
            android:label="@string/cortana_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/recognition_service" />
        </service>

        <!--
          The speech engines' own process (Decisions "Model storage and process"). Not exported: only the
          shell binds it. Its death leaves Start, tiles, the listener, the IME and the dialer untouched (E12).
        -->
        <service
            android:name=".cortana.speech.SpeechService"
            android:process=":speech"
            android:exported="false" />

        <!-- ===== Phase 05: the keyboard ===== -->

        <!--
          The W10M keyboard (Decisions: shell-owned IME in the one APK). Guarded by BIND_INPUT_METHOD,
          which only the system holds. Its own process: a keyboard crash cannot take Start with it (and
          Start's cannot take the keyboard), and the :speech process sees it as a client of its own when
          the voice key and Cortana both want the one microphone.
        -->
        <service
            android:name=".ime.KeyboardService"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:process=":ime"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <!-- The keyboard's settings, read across the process boundary. Not exported: only this app calls it. -->
        <provider
            android:name=".ime.KeyboardConfigProvider"
            android:authorities="app.tileshell.keyboardconfig"
            android:exported="false" />

        <!-- Reminder alarms, proximity alerts, and the re-registration a reboot or an update needs. -->
        <!--
          Also Alarms & Clock's alarms and timers (phase 15): their fire broadcasts, the re-arm before the first unlock
          (directBootAware; LOCKED_BOOT_COMPLETED), and a zone or clock change moving an alarm's wall-clock instant.
        -->
        <receiver
            android:name=".cortana.reminders.ReminderReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!--
          Phase 15: the ring. Started only from an alarm's broadcast; not exported (nothing outside the shell may make
          it ring). Direct-boot aware so an alarm rings before the first unlock (T15-22).
        -->
        <service
            android:name=".clock.RingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!--
          Phase 15: the ring toast over the keyguard (Q-E A). Started only by the ring's own full-screen intent; not
          exported; draws only the toast and never dismisses the keyguard (T15-33 (b)).
        -->
        <activity
            android:name=".clock.RingActivity"
            android:directBootAware="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:taskAffinity="app.tileshell.clock.ring"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode" />

        <!--
          Shown when another app holds the assistant role: a session cannot open without the role, so the
          Search key opens this page instead, which offers the role request (H30). Not exported — only the
          shell starts it.
        -->
        <!--
          Raises Android's unlock prompt for the "Unlock to continue" card (H12): a session is not an
          Activity, and requestDismissKeyguard needs one. Draws nothing.
        -->
        <activity
            android:name=".cortana.CortanaUnlockActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="app.tileshell.cortana.unlock" />

        <!--
          Grants a checklist row's permission or asks for the assistant role. A session cannot raise
          either prompt; this is the smallest thing that can. Draws nothing.
        -->
        <activity
            android:name=".cortana.CortanaPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:taskAffinity="app.tileshell.cortana.permission" />

        <activity
            android:name=".cortana.CortanaRoleNoticeActivity"
            android:exported="false"
            android:taskAffinity="app.tileshell.cortana"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode" />

        <!-- ===== Phase 15: Voice Recorder (build task 7) ===== -->

        <!--
          Voice Recorder: an app in the app list like Music, with its own task. Exported only because it is a
          launcher activity. Its icon's monochrome layer is its static Start tile (U12: the Microphone glyph).
          The App Shortcuts' "page" extra only picks the record or list state; it never starts a take.
        -->
        <activity
            android:name=".recorder.RecorderActivity"
            android:exported="true"
            android:label="@string/recorder_name"
            android:icon="@drawable/ic_recorder"
            android:taskAffinity="app.tileshell.recorder"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts_recorder" />
        </activity>

        <!--
          The take: a microphone foreground service in its own process, so a crash of Start or of the page
          cannot end it. Not exported: only the shell starts, binds and stops it.
        -->
        <service
            android:name=".recorder.RecorderService"
            android:process=":recorder"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ===== Phase 15: Calculator (build task 6) ===== -->

        <!--
          Calculator: an app in the app list like Music, with its own task. Exported only because it is a
          launcher activity. Its icon's monochrome layer is its static Start tile (the Calculator glyph).
          The App Shortcuts' "page" extra (build task 9) only picks the page shown.
        -->
        <activity
            android:name=".calculator.CalculatorActivity"
            android:exported="true"
            android:label="@string/calculator_name"
            android:icon="@drawable/ic_calculator"
            android:taskAffinity="app.tileshell.calculator"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALCULATOR" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts_calculator" />
        </activity>
    </application>
</manifest>
