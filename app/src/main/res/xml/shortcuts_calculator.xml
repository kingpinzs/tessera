<?xml version="1.0" encoding="utf-8"?>
<!--
  Calculator's static App Shortcuts (phase 15 build task 9, phase 11 Q1's standing rule; Decisions 2026-09-23):
  its four top-level screens, Standard, Scientific, Programmer and the Converter (Date calculation is not a fifth:
  the four-satellite cap). Declaration order is the rank (0–3). Each opens CalculatorActivity with the extra "page"
  (the key SettingsActivity.EXTRA_PAGE uses); "converter" opens the last-used category, Volume the first time (T15-43).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="standard"
        android:enabled="true"
        android:icon="@drawable/ic_calculator_glyph"
        android:shortcutShortLabel="@string/calculator_shortcut_standard"
        android:shortcutLongLabel="@string/calculator_shortcut_standard">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.calculator.CalculatorActivity">
            <extra android:name="page" android:value="standard" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="scientific"
        android:enabled="true"
        android:icon="@drawable/ic_calculator_glyph"
        android:shortcutShortLabel="@string/calculator_shortcut_scientific"
        android:shortcutLongLabel="@string/calculator_shortcut_scientific">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.calculator.CalculatorActivity">
            <extra android:name="page" android:value="scientific" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="programmer"
        android:enabled="true"
        android:icon="@drawable/ic_calculator_glyph"
        android:shortcutShortLabel="@string/calculator_shortcut_programmer"
        android:shortcutLongLabel="@string/calculator_shortcut_programmer">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.calculator.CalculatorActivity">
            <extra android:name="page" android:value="programmer" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="converter"
        android:enabled="true"
        android:icon="@drawable/ic_calculator_glyph"
        android:shortcutShortLabel="@string/calculator_shortcut_converter"
        android:shortcutLongLabel="@string/calculator_shortcut_converter">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.calculator.CalculatorActivity">
            <extra android:name="page" android:value="converter" />
        </intent>
    </shortcut>
</shortcuts>
