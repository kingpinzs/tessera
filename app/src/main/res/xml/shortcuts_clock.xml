<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 15 build task 9 (phase 11 Q1's standing rule; Decisions 2026-09-23): Alarms & Clock's static App
  Shortcuts — its four tabs, ranks 0–3 in file order, each an intent to ClockActivity with the `page` extra
  (the key SettingsActivity.EXTRA_PAGE already uses). A hold on the app's tile bursts them (E27).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="alarm"
        android:enabled="true"
        android:shortcutShortLabel="@string/clock_shortcut_alarm"
        android:shortcutLongLabel="@string/clock_shortcut_alarm">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.clock.ClockActivity">
            <extra android:name="page" android:value="alarm" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="timer"
        android:enabled="true"
        android:shortcutShortLabel="@string/clock_shortcut_timer"
        android:shortcutLongLabel="@string/clock_shortcut_timer">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.clock.ClockActivity">
            <extra android:name="page" android:value="timer" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="stopwatch"
        android:enabled="true"
        android:shortcutShortLabel="@string/clock_shortcut_stopwatch"
        android:shortcutLongLabel="@string/clock_shortcut_stopwatch">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.clock.ClockActivity">
            <extra android:name="page" android:value="stopwatch" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="world_clock"
        android:enabled="true"
        android:shortcutShortLabel="@string/clock_shortcut_world_clock"
        android:shortcutLongLabel="@string/clock_shortcut_world_clock">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.tileshell"
            android:targetClass="app.tileshell.clock.ClockActivity">
            <extra android:name="page" android:value="world_clock" />
        </intent>
    </shortcut>
</shortcuts>
