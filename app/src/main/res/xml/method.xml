<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 05: the shell's keyboard. English (US) only (Decisions, R2D-12: one layout, one dictionary, one
  voice-typing model, no language key). The settings gear in Android's keyboard list opens Start settings,
  whose Keyboard page holds the keyboard's options: no extra exported component just to deep-link.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="app.tileshell.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/keyboard_subtype"
        android:imeSubtypeLocale="en_US"
        android:languageTag="en-US"
        android:imeSubtypeMode="keyboard" />
</input-method>
