<?xml version="1.0" encoding="utf-8"?>
<!--
  Files' launcher icon (phase 18 build task 1): the glyph on the out-of-box accent for places that draw the
  full-colour icon. Start draws the monochrome layer white on the accent tile (start/TileIcons.kt).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/files_icon_background" />
    <foreground>
        <inset android:drawable="@drawable/ic_files_glyph" android:inset="33%" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/ic_files_glyph" android:inset="33%" />
    </monochrome>
</adaptive-icon>
