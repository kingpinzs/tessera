<?xml version="1.0" encoding="utf-8"?>
<!--
  People's launcher icon (phase 16 build task 2; H19 judges it): the glyph on the out-of-box accent
  (Palette.DEFAULT_ACCENT) for places that draw the full-colour icon. Start draws an app's monochrome layer white on
  the accent tile (start/TileIcons.kt), so the monochrome layer is the static face of the app's own tile.
  The live photo-bubble face is PeopleFeed's (R3 A9), published over it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/people_icon_background" />
    <foreground>
        <inset android:drawable="@drawable/ic_people_glyph" android:inset="33%" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/ic_people_glyph" android:inset="33%" />
    </monochrome>
</adaptive-icon>
