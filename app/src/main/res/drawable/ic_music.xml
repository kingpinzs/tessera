<?xml version="1.0" encoding="utf-8"?>
<!--
  Music's launcher icon, made as Alarms & Clock's, Calculator's and Voice Recorder's are: its glyph on the
  out-of-box accent (Palette.DEFAULT_ACCENT); Start draws the monochrome layer white on the accent tile where no live
  face is published.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/music_icon_background" />
    <foreground>
        <inset android:drawable="@drawable/ic_music_glyph" android:inset="33%" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/ic_music_glyph" android:inset="33%" />
    </monochrome>
</adaptive-icon>
