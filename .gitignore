# Gradle / Android
.gradle/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/
# Signing material never goes in git
*.jks
*.keystore
keystore.properties
# QA bulk artefacts stay local (evidence index files are committed)
docs/plan/qa/**/*.mp4
# Frames extracted from those captures are bulk too: they are rebuilt from the .mp4 by the row itself.
docs/plan/qa/phase-05/**/*_frames/
# Editor history
.history/

# Agent worktrees
.claude/
.speechsrc/

# Phase 03 speech payload: fetched by tools/fetch-speech.sh, pinned by sha256 there
app/libs/
app/src/main/assets/speech/

# Phase 05 keyboard payload: fetched by tools/fetch-keyboard.sh, pinned by sha256 there
.keyboardsrc/
app/src/main/assets/keyboard/
app/src/main/assets/licenses/scowl-2020.12.07-Copyright.txt
app/src/main/assets/licenses/12dicts-6.0.2-LICENSE.txt
app/src/main/assets/licenses/12dicts-6.0.2-agid.txt
app/src/main/assets/licenses/fluentui-emoji-MIT.txt
app/src/main/assets/licenses/unicode-emoji-LICENSE.txt

# Third-party research images (Microsoft wallpapers, review-site screenshots) stay local until Jeremy rules on
# committing them to a repo that is pushed; each research doc keeps its source URL and sha256 (2026-09-23).
docs/plan/r12/*.jpg
docs/plan/r12/*.png
docs/plan/r11/src/
