app/src/main/assets/licenses/fluentui-emoji-MIT.txt
app/src/main/assets/licenses/unicode-emoji-LICENSE.txt

# R11's third-party source screenshots (98 MB) stay local; each r11 section keeps its source URL and sha256. R12's images
# ARE committed: Jeremy, 2026-09-23, re-asked knowing the repo is PUBLIC, answered "(c)" — commit them publicly anyway.
docs/plan/r11/src/

# audio.sh runtime state (a PulseAudio module id and the previous default source), not evidence
docs/plan/qa/*/.audio-state*
