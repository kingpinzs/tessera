$ adb shell am start -W -n app.tileshell/.recorder.RecorderActivity --es page list   # fresh page, no recordings
  page nodes: resource-id="rec_button" resource-id="rec_empty" resource-id="rec_list" resource-id="rec_more" resource-id="rec_page:list" resource-id="rec_root"
$ adb shell input keyevent KEYCODE_HOME   # the page is stopped (onStop unregisters its ContentObserver)
$ adb push fixtures/other.m4a /sdcard/Recordings/other.m4a && content call scan_volume   # MediaStore changes while the page is stopped
