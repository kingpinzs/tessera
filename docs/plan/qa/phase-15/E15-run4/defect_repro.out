$ adb shell content query --uri content://media/external/audio/media --projection _id:_display_name:is_recording --where "is_recording=1"
  Row: 0 _id=38, _display_name=other.m4a, is_recording=1
$ adb shell am start -W -n app.tileshell/.recorder.RecorderActivity --es page list   # the same activity instance resumes (onNewIntent, onStart)
  page nodes: resource-id="rec_button" resource-id="rec_empty" resource-id="rec_list" resource-id="rec_more" resource-id="rec_page:list" resource-id="rec_root"
