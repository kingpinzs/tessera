<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera / storage: it HOLDS no runtime permission — whatever the shell's Camera writes for this app, it writes
         through this app's own grant. WRITE_CONTACTS is declared and never granted at install (the rows install without
         -g); E9's second display_photo leg grants it with `pm grant` for its span, to record what the guard reads then. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Phase 18 ledger L18-3 (l18_3's SetAlarmActivity): the AlarmClock API handler is guarded by this permission.
         It is a normal permission, granted at install, so this app can reach AlarmApiActivity the way any app can;
         it grants nothing over the user's files. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <queries>
        <package android:name="app.tileshell" />
    </queries>

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="QA Capture">

        <!-- No LAUNCHER entry: it never shows in the shell's app list. Started by the row with `am start -n`. -->
        <activity
            android:name=".CaptureProbeActivity"
            android:exported="true" />

        <!-- E5 (phase 17): Photos' Share picks this in the system chooser; it logs what it was sent.
             Phase 18 E7 (r3 V2) widened it: one stream of any type, and SEND_MULTIPLE of any type. `*/*` covers
             phase 17's `image/*`, so the chooser still lists this one activity once for an image share. -->
        <activity
            android:name=".SendProbeActivity"
            android:exported="true"
            android:label="QA Capture">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The probe's own sender, for the phase 18 floor's self-test (`am start` cannot carry a URI list). No filter. -->
        <activity
            android:name=".SendDriverActivity"
            android:exported="true" />

        <!-- Ledger L18-1: another app's controller on the shell's exported music session (a Media3 controller and a legacy
             MediaBrowser), handing it an item that carries a URI. Started by the row with `am start -n`. No filter.
             Phase 18 l18_4 leg a (N3) extends it with a `setMediaItems` list + start-index path. -->
        <activity
            android:name=".MediaProbeActivity"
            android:exported="true" />

        <!-- Phase 18 ledger L18-3 / L18-4 senders, started by the row with `am start -n` (no filter):
             ClockEditActivity  — a hostile `api_edit` Bundle to the shell's ClockActivity (N1, P3-4)
             SetAlarmActivity   — SET_ALARM with a foreign Parcelable in EXTRA_DAYS (N4) or a readable MediaStore
                                  ringtone (N12), to AlarmApiActivity (needs SET_ALARM, declared above)
             LegacyQueueActivity — a framework-legacy skipToQueueItem with an out-of-range id (P3-1) -->
        <activity
            android:name=".ClockEditActivity"
            android:exported="true" />
        <activity
            android:name=".SetAlarmActivity"
            android:exported="true" />
        <activity
            android:name=".LegacyQueueActivity"
            android:exported="true" />

        <!-- Its own file provider: the capture's output lives in this app's cache and is reached only by a URI grant. -->
        <provider
            android:name=".OutputProvider"
            android:authorities="app.tileshell.testclient.qacapture.output"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
