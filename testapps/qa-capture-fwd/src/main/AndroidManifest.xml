<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permission at all. -->

    <queries>
        <package android:name="app.tileshell" />
        <package android:name="app.tileshell.testclient.qacapture" />
    </queries>

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="QA Capture Forward">

        <!-- No LAUNCHER entry. Started by the row with `am start -n`. -->
        <activity
            android:name=".ForwardStartActivity"
            android:exported="true" />

        <provider
            android:name=".FwdProvider"
            android:authorities="app.tileshell.testclient.qacapturefwd.output"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
