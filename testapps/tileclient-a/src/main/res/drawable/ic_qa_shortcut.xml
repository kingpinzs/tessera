    <background android:drawable="@color/qa_shortcut_background" />
    <foreground android:drawable="@drawable/ic_qa_shortcut_glyph" />
    <monochrome android:drawable="@drawable/ic_qa_shortcut_glyph" />
</adaptive-icon>
