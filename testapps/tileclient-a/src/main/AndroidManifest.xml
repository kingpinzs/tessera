<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility for ShortcutBadger-style receiver resolution (queryBroadcastReceivers). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.BADGE_COUNT_UPDATE" />
        </intent>
        <intent>
            <action android:name="me.leolin.shortcutbadger.BADGE_COUNT_UPDATE" />
        </intent>
    </queries>

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Tile client A">

        <activity
            android:name="app.tileshell.testclient.VerbActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase 11 (T11-13): the five static App Shortcuts belong to this LAUNCHER activity, the component the
                 tile is; the shell's per-activity query reads them here. ShortcutActivity is only their target. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Phase 11 (T11-47): the static shortcuts' target; shows the qa_id extra in @id/shortcut_id. Not exported:
             LauncherApps.startShortcut starts it as this app, the shortcuts' publisher. -->
        <activity
            android:name="app.tileshell.testclient.ShortcutActivity"
            android:exported="false" />

        <provider
            android:name="app.tileshell.testclient.TestImageProvider"
            android:authorities="${applicationId}.images"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
