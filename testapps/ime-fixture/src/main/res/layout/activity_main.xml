<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity: the mirror block, then a ScrollView of labelled fields. Field ids are the contract.
     No android:hint anywhere: an empty EditText reports its hint as `text` in a uiautomator dump. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:importantForAutofill="noExcludeDescendants">

    <include layout="@layout/mirrors" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/label_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_text: text (plain, no cap)" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="text" />

            <TextView
                android:id="@+id/label_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_number: number" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="number" />

            <TextView
                android:id="@+id/label_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_phone: phone" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="phone" />

            <TextView
                android:id="@+id/label_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_email: textEmailAddress" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="textEmailAddress" />

            <TextView
                android:id="@+id/label_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_password: textPassword" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/label_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_url: textUri + actionGo" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="textUri"
                android:imeOptions="actionGo" />

            <TextView
                android:id="@+id/label_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_search: text + actionSearch" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/label_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_send: text + actionSend" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionSend" />

            <TextView
                android:id="@+id/label_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_next: text + actionNext" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionNext" />

            <TextView
                android:id="@+id/label_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_done: text + actionDone" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionDone" />

            <TextView
                android:id="@+id/label_multiline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_multiline: textMultiLine" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_multiline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/label_nosuggest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_nosuggest: textNoSuggestions" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_nosuggest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="textNoSuggestions" />

            <TextView
                android:id="@+id/label_capsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_capsent: textCapSentences" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_capsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="textCapSentences" />

            <TextView
                android:id="@+id/label_capwords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_capwords: textCapWords" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_capwords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="textCapWords" />

            <TextView
                android:id="@+id/label_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:text="field_filter: text, max 5, a-z only (filters set in code)" />

            <app.tileshell.qa.imefixture.MirrorEditText
                android:id="@+id/field_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:inputType="text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
