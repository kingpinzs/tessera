<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="IME fixture"
        android:theme="@style/Theme.ImeFixture">

        <!-- The launcher screen: a ScrollView of labelled EditTexts, one per input type / IME action.
             Extra "focus" (a field id name, e.g. field_email) focuses that field on start and asks
             for the keyboard. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- E9's tap-through target: top_field at the top, bottom_field anchored to the bottom of the
             window, and the window does not resize for the keyboard (adjustNothing), so the bottom
             field sits in the band below a keyboard panel that was dragged upward. -->
        <activity
            android:name=".BottomFieldActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing|stateHidden" />
    </application>
</manifest>
