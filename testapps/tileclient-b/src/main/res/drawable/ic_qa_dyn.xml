<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 11 (T11-33): qa_dyn's icon (Icon.createWithResource), an adaptive icon with a monochrome layer, so E3 can
     assert satellite 0 draws a glyph while qa_noicon's satellite draws none. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/qa_dyn_background" />
    <foreground android:drawable="@drawable/ic_qa_dyn_glyph" />
    <monochrome android:drawable="@drawable/ic_qa_dyn_glyph" />
</adaptive-icon>
